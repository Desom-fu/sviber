{
	"name": "sviber",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Desktop-style chart editor for Sunniesnow",
	"main": "index.html",
	"sviber-source": true,
	"window": {
		"title": "sviber",
		"width": 1440,
		"height": 900,
		"min_width": 960,
		"min_height": 620,
		"position": "center",
		"icon": "icon.ico"
	},
	"scripts": {
		"start": "http-server .. -p 4173 -c-1",
		"check:size": "node scripts/check-source-size.mjs",
		"check:parity": "node scripts/check-editor-parity.mjs",
		"build": "node scripts/check-source-size.mjs && node scripts/build-nw.mjs",
		"benchmark:render": "node scripts/benchmark-render-index.mjs",
		"test": "node scripts/check-source-size.mjs && node scripts/check-editor-parity.mjs && node --test tests/*.test.mjs",
		"verify:browser": "node scripts/check-source-size.mjs && node scripts/verify-browser.mjs"
	},
	"dependencies": {
		"audio-decode": "^3.12.0",
		"jszip": "^3.10.1",
		"mathjs": "^15.2.0",
		"pixi.js": "^8.19.0"
	},
	"devDependencies": {
		"esbuild": "^0.28.2",
		"http-server": "^14.1.1",
		"nw": "^0.114.2",
		"nw-builder": "^4.18.0",
		"playwright-core": "^1.62.1",
		"pngjs": "^7.0.0"
	}
}
