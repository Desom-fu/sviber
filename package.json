{
	"name": "sviber",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Desktop-style chart editor for Sunniesnow",
	"main": "index.html",
	"window": {
		"title": "sviber",
		"width": 1440,
		"height": 900,
		"min_width": 960,
		"min_height": 620,
		"position": "center",
		"icon": "icon.svg"
	},
	"scripts": {
		"start": "http-server .. -p 4173 -c-1",
		"build": "node scripts/build-nw.mjs",
		"test": "node --test tests/*.test.mjs",
		"verify:browser": "node scripts/verify-browser.mjs"
	},
	"dependencies": {
		"audio-decode": "3.9.3",
		"jszip": "3.10.1",
		"mathjs": "15.2.0",
		"pixi.js": "8.18.1"
	},
	"devDependencies": {
		"http-server": "14.1.1",
		"nw": "0.114.1",
		"nw-builder": "4.18.0",
		"playwright-core": "^1.62.1",
		"pngjs": "^7.0.0"
	}
}
